---
import Base from '../layouts/Base.astro';
import FunctionCard from '../components/FunctionCard.astro';
import { getGraph } from '../lib/graph';
import { composeFunction } from '../lib/compose';

const graph = getGraph();
const pages = graph.functions.map((fn) => composeFunction(graph, fn));
const screens = [...graph.screens.values()];
---

<Base title="GoodsBar 使用手册 · 按需求找功能">
  <section class="mb-9">
    <p class="text-[11px] font-semibold tracking-[0.08em] text-secondary">
      GoodsBar 使用手册
    </p>
    <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight sm:text-[2.6rem]">
      回答你使用<span class="text-secondary"> GoodsBar </span>时遇到的<span class="text-secondary">所有问题</span>
    </h1>
    <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-base-content/65">
      这里没有按菜单排的目录。每一页说明都是围绕一件具体的事组织的：一个问题对应一个功能，功能拆成若干个行为，行为再落到某一个界面上的具体几步操作。
    </p>
  </section>

  <section class="mb-6 space-y-3">
    <div class="relative">
      <svg
        class="pointer-events-none absolute left-4 top-1/2 h-4.5 w-4.5 -translate-y-1/2 text-base-content/35"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        id="q"
        type="search"
        autocomplete="off"
        placeholder="搜索需求，例如「盘点」「折扣」「下架」"
        aria-label="搜索需求"
        class="input input-bordered w-full pl-11"
      />
    </div>

    <div class="flex flex-wrap items-center gap-1.5">
      <span class="mr-1 text-xs text-base-content/45">按界面筛选</span>
      <button type="button" class="btn btn-xs btn-primary" data-chip="all" aria-pressed="true">全部</button>
      {
        screens.map((screen) => (
          <button type="button" class="btn btn-xs btn-ghost" data-chip={screen.id} aria-pressed="false">
            {screen.name}
          </button>
        ))
      }
    </div>
  </section>

  <p class="mb-3 text-xs text-base-content/45">选一个和你处境最接近的</p>

  <div class="grid gap-3 sm:grid-cols-2">
    {pages.map((page) => <FunctionCard page={page} />)}
  </div>

  <div id="empty" class="hidden rounded-xl border border-dashed border-base-300 bg-base-100 px-6 py-12 text-center">
    <p class="text-sm text-base-content/60">没有匹配的需求。</p>
    <p class="mt-1 text-xs text-base-content/40">换个说法试试，或者点「全部」。</p>
  </div>
</Base>

<script>
  const input = document.getElementById('q') as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-chip]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const empty = document.getElementById('empty');

  let active = 'all';

  function apply() {
    const term = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;

    for (const card of cards) {
      const text = card.dataset.search ?? '';
      const screens = (card.dataset.screens ?? '').split(' ');
      const matched = (active === 'all' || screens.includes(active)) && (term === '' || text.includes(term));

      card.classList.toggle('hidden', !matched);
      if (matched) shown += 1;
    }

    empty?.classList.toggle('hidden', shown !== 0);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      active = chip.dataset.chip ?? 'all';

      for (const other of chips) {
        const on = other === chip;
        other.setAttribute('aria-pressed', String(on));
        other.classList.toggle('btn-primary', on);
        other.classList.toggle('btn-ghost', !on);
      }

      apply();
    });
  }

  // 输入框里按 Esc 清空
  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      input.value = '';
      apply();
    }
  });

  input?.addEventListener('input', apply);
  apply();
</script>
