---
import type { Behavior, Func, Screen } from '../lib/graph';
import { functionUrl } from '../lib/graph';

interface Props {
  screen: Screen;
  entries: { fn: Func; behavior: Behavior }[];
}

const { screen, entries } = Astro.props;
---

<section id={screen.id} class="rounded-3xl bg-base-100 p-5 shadow-xs">
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h2 class="text-base font-semibold">{screen.name}</h2>
    {
      screen.parent && (
        <span class="rounded-full bg-base-200 px-2 py-0.5 text-[10px] text-base-content/50">二级界面</span>
      )
    }
  </div>

  {screen.note && <p class="mt-1.5 text-[13px] leading-relaxed text-base-content/55">{screen.note}</p>}

  <ul class="mt-3 divide-y divide-base-200/70">
    {
      entries.map(({ fn, behavior }) => (
        <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 py-2">
          <span class="text-sm">{behavior.title}</span>
          <a
            href={functionUrl(fn.id)}
            class="ml-auto text-[11px] link link-hover text-base-content/50 hover:text-secondary"
          >
            {fn.question}
          </a>
        </li>
      ))
    }
  </ul>
</section>
