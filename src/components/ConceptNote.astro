---
import type { Concept } from '../lib/graph';
import { conceptUrl } from '../lib/graph';

interface Props {
  concept: Concept;
}

const { concept } = Astro.props;
---

<aside class="mt-3 rounded-2xl bg-base-200/60 px-4 py-3">
  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <span class="text-[10px] font-semibold tracking-[0.08em] text-secondary">概念</span>
    <a href={conceptUrl(concept.id)} class="link link-hover text-sm font-semibold">
      {concept.title}
    </a>
  </div>

  <p class="mt-1 text-[13px] leading-relaxed text-base-content/65">{concept.summary}</p>

  <a
    href={conceptUrl(concept.id)}
    class="mt-1.5 inline-flex items-center gap-1 text-[11px] text-base-content/40 hover:text-secondary"
  >
    看完整词条
    <span aria-hidden="true">→</span>
  </a>
</aside>
